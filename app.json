{
  "expo": {
    "name": "Quill",
    "slug": "quill",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quill",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicesapien.quill",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["VIBRATE"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nicesapien.quill"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.PNG"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-vector-icons/ionicons",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-video",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Microphone permission to record voice notes."
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Quill uses Face ID to support app lock." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ee4ac16-beee-40da-96c2-3a6f20b27163"
      }
    },
    "owner": "nicesapiens-team"
  }
}
